{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store",
      "credentialsSource": "local",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local"
    },
    "production": {
      "autoIncrement": false,
      "credentialsSource": "local"
    }
  }
}
